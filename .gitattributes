# What a game's copy of the toolkit does not need (tools/sync-toolkit.sh copies what git archive gives):
# this repository's own project files, its checks and the stand-in game they build. Each is named from the
# top, so that nothing of the same name further down (recomp-common's launcher/example) is left out.
/.gitattributes export-ignore
/.github export-ignore
/example export-ignore
/Makefile export-ignore
/tools/audit.sh export-ignore
/tools/ci_smoke.sh export-ignore
/CONTRIBUTING.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md export-ignore
/CHANGELOG.md export-ignore
/VERSION export-ignore
/THIRD_PARTY_NOTICES.md export-ignore
